{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicError Canonical Rows",
  "description": "v1 frozen error codes per PRD 2.5. Any addition, deletion, or semantic change requires error-contract version bump.",
  "version": "v1",
  "rows": [
    {"code": "VALIDATION_FAILED", "http_status": 422, "retryable": false, "client_action": "fix_input"},
    {"code": "AUTH_REQUIRED", "http_status": 401, "retryable": false, "client_action": "authenticate"},
    {"code": "AUTH_INVALID", "http_status": 401, "retryable": false, "client_action": "reauthenticate"},
    {"code": "FORBIDDEN", "http_status": 403, "retryable": false, "client_action": "none"},
    {"code": "NOT_FOUND", "http_status": 404, "retryable": false, "client_action": "none"},
    {"code": "CONFLICT", "http_status": 409, "retryable": false, "client_action": "refresh"},
    {"code": "IDEMPOTENCY_CONFLICT", "http_status": 409, "retryable": false, "client_action": "use_new_idempotency_key"},
    {"code": "RATE_LIMITED", "http_status": 429, "retryable": true, "client_action": "retry_after"},
    {"code": "SERVICE_UNAVAILABLE", "http_status": 503, "retryable": true, "client_action": "retry"},
    {"code": "SAFETY_GATE_UNAVAILABLE", "http_status": 503, "retryable": true, "client_action": "retry"},
    {"code": "TEXT_ENTRY_NOT_REGISTERED", "http_status": 500, "retryable": false, "client_action": "contact_support"},
    {"code": "TEXT_ENTRY_CONTEXT_MISMATCH", "http_status": 400, "retryable": false, "client_action": "fix_input"},
    {"code": "WS_COMMAND_INVALID", "http_status": 400, "retryable": false, "client_action": "reconnect"},
    {"code": "WS_ACK_INVALID", "http_status": 409, "retryable": false, "client_action": "resume"},
    {"code": "WS_RESUME_INVALID", "http_status": 409, "retryable": false, "client_action": "reconnect"},
    {"code": "WS_TICKET_INVALID", "http_status": 401, "retryable": false, "client_action": "obtain_new_ticket"},
    {"code": "OUTPUT_BLOCKED", "http_status": 422, "retryable": false, "client_action": "show_safe_template"},
    {"code": "ASSESSMENT_VERSION_CONFLICT", "http_status": 409, "retryable": false, "client_action": "refetch_definition"},
    {"code": "SAFETY_CONFIRMATION_REQUIRED", "http_status": 423, "retryable": false, "client_action": "open_safety_confirmation"},
    {"code": "ASSESSMENT_RESULT_DELETED", "http_status": 410, "retryable": false, "client_action": "remove_local_copy"},
    {"code": "RECOVERY_TOKEN_INVALID", "http_status": 400, "retryable": false, "client_action": "restart_recovery"},
    {"code": "GUEST_SESSION_INVALID", "http_status": 401, "retryable": false, "client_action": "create_guest_session"},
    {"code": "GUEST_SESSION_EXPIRED", "http_status": 401, "retryable": false, "client_action": "create_guest_session"},
    {"code": "CONTENT_WITHDRAWN", "http_status": 410, "retryable": false, "client_action": "remove_local_copy"},
    {"code": "DELETION_IN_PROGRESS", "http_status": 202, "retryable": false, "client_action": "show_pending"},
    {"code": "INTERNAL_ERROR", "http_status": 500, "retryable": true, "client_action": "retry"}
  ]
}
