# --- Stage 1: Build dependencies ---
FROM python:3.10-slim AS builder

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /usr/local/bin/uv

# Copy workspace files
COPY pyproject.toml .python-version ./
COPY src/mental_health_api/pyproject.toml src/mental_health_api/
COPY src/mental_health_ai/pyproject.toml src/mental_health_ai/

# Install dependencies (layered for caching)
RUN uv sync --frozen --extra ai --extra onnx --no-editable

# --- Stage 2: Runtime ---
FROM python:3.10-slim AS runtime

WORKDIR /app

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Copy virtualenv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application source
COPY src/mental_health_api/ src/mental_health_api/
COPY src/mental_health_ai/ src/mental_health_ai/
COPY pyproject.toml ./

# Set environment
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER appuser

EXPOSE 8000

CMD ["uvicorn", "mental_health_api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
