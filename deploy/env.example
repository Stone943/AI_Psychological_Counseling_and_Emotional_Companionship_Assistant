# ============================================================
# mental_health_api — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# Secrets should NOT be stored here; use external files or CI secret vars.

# --- Server ---
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database (MySQL for prod, SQLite for test) ---
DATABASE_URL=sqlite+aiosqlite:///./mental_health.db
# DATABASE_URL=mysql+asyncmy://user:pass@mysql:3306/mental_health

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Encryption ---
# Path to a file containing the AES-256 encryption key (64 hex chars)
ENCRYPTION_KEY_REF=

# --- JWT / Tokens ---
JWT_SECRET_KEY=change-me-to-a-real-secret
REFRESH_TOKEN_SECRET=change-me-to-a-real-secret

# --- CORS ---
CORS_ORIGINS=["*"]

# --- TLS ---
FORCE_TLS=false

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Content & Contracts ---
CONTENT_DIR=content
CONTRACTS_DIR=contracts
