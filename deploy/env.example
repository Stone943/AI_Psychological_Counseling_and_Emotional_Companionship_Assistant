# ============================================================
# mental_health_api — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# Secrets should NOT be stored here; use external files or CI secret vars.

# --- Server ---
MENTAL_HEALTH_ENVIRONMENT=development
MENTAL_HEALTH_DEBUG=true
MENTAL_HEALTH_HOST=0.0.0.0
MENTAL_HEALTH_PORT=8000

# --- Database (MySQL for prod, SQLite for test) ---
MENTAL_HEALTH_DATABASE_URL=sqlite+aiosqlite:///./mental_health.db
# Production/demo: MENTAL_HEALTH_DATABASE_URL_FILE=/run/secrets/database_url

# --- Redis ---
MENTAL_HEALTH_REDIS_URL=redis://redis:6379/0

# --- Encryption ---
# Path to a file containing the AES-256 encryption key (64 hex chars)
MENTAL_HEALTH_ENCRYPTION_KEY_REF=

# --- JWT / Tokens ---
MENTAL_HEALTH_JWT_SECRET_KEY=change-me-to-a-real-secret
MENTAL_HEALTH_REFRESH_TOKEN_SECRET=change-me-to-a-real-secret

# --- CORS ---
MENTAL_HEALTH_CORS_ORIGINS=["*"]

# --- TLS ---
MENTAL_HEALTH_FORCE_TLS=false

# --- Rate Limiting ---
MENTAL_HEALTH_RATE_LIMIT_ENABLED=true
MENTAL_HEALTH_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- Content & Contracts ---
MENTAL_HEALTH_CONTENT_DIR=content
MENTAL_HEALTH_CONTRACTS_DIR=contracts
